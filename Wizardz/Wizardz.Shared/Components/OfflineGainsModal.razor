@inject GameEngine Engine

@if (_visible)
{
    <div class="modal-backdrop" @onclick="Dismiss">
        <div class="modal-box offline-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>📜 Welcome Back, Archmage!</h3>
            </div>
            <div class="offline-body">
                <div class="offline-icon">⏳</div>
                <p>While you were wandering the mortal realm, your tower wizards continued their incantations:</p>
                
                <div class="offline-stats">
                    <div class="stat-line">
                        <span>Time Away:</span>
                        <strong>@FormatTimeSpan(_timeAway)</strong>
                    </div>
                    <div class="stat-line highlight">
                        <span>Mana Channelled:</span>
                        <strong class="mana-gain">+@GameEngine.FormatNumber(_manaGained) 🔮</strong>
                    </div>
                </div>

                <button class="btn-claim-offline" @onclick="Dismiss">
                    ✨ Claim Mana & Return to Spire
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible = false;
    private double _manaGained = 0;
    private TimeSpan _timeAway = TimeSpan.Zero;

    protected override void OnInitialized()
    {
        Engine.OnOfflineGainsCalculated += HandleOfflineGains;
    }

    private void HandleOfflineGains(double mana, TimeSpan time)
    {
        _manaGained = mana;
        _timeAway = time;
        _visible = true;
        InvokeAsync(StateHasChanged);
    }

    private void Dismiss()
    {
        _visible = false;
    }

    private static string FormatTimeSpan(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
        {
            return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        }
        if (ts.TotalMinutes >= 1)
        {
            return $"{ts.Minutes}m {ts.Seconds}s";
        }
        return $"{ts.Seconds}s";
    }
}
