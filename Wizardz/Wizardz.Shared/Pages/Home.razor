@page "/"
@implements IDisposable
@inject GameEngine Engine

<PageTitle>Wizardz - Arcane Spire</PageTitle>

<div class="game-viewport">
    <!-- Top Header Status Bar -->
    <header class="game-header">
        <div class="brand-section">
            <span class="brand-icon">🧙‍♂️</span>
            <h1 class="brand-title">WIZARDZ</h1>
        </div>

        <div class="resources-bar">
            <!-- Mana Pill -->
            <div class="resource-pill mana">
                <span class="res-icon">🔮</span>
                <div class="res-data">
                    <span class="res-value">@GameEngine.FormatNumber(Engine.State.Mana)</span>
                    <span class="res-rate">+@GameEngine.FormatNumber(Engine.State.CurrentMps)/s</span>
                </div>
            </div>

            <!-- Arcane Essence Pill -->
            <div class="resource-pill essence">
                <span class="res-icon">💠</span>
                <div class="res-data">
                    <span class="res-value">@GameEngine.FormatNumber(Engine.State.ArcaneEssence)</span>
                    <span class="res-rate">Essence</span>
                </div>
            </div>

            <!-- Astral Shards Pill -->
            @if (Engine.State.AstralShards > 0 || Engine.State.LifetimeMana >= 50_000)
            {
                <div class="resource-pill astral">
                    <span class="res-icon">⭐</span>
                    <div class="res-data">
                        <span class="res-value">@GameEngine.FormatNumber(Engine.State.AstralShards)</span>
                        <span class="res-rate">Astral</span>
                    </div>
                </div>
            }
        </div>

        <div class="header-actions">
            <button class="btn-icon-action" @onclick="ManualSave" title="Save Game">
                💾 Save
            </button>
            <button class="btn-icon-action" @onclick="() => _showSettingsModal = true" title="Settings">
                ⚙️ Settings
            </button>
        </div>
    </header>

    <!-- Main Game Workspace -->
    <div class="game-main-content">
        <!-- Top-Down Dungeon Viewport + Spellbook Bar -->
        <section class="spire-stage dungeon-stage">
            <TopDownDungeonView />
            <SpellbookBar />
        </section>

        <!-- Right Management Tab Panel -->
        <aside class="management-panel">
            <nav class="tab-nav">
                <button class="tab-btn @(_activeTab == "gear" ? "active" : "")" @onclick="@(() => _activeTab = "gear")">
                    ⚔️ Gear (@Engine.State.Inventory.Count)
                </button>
                <button class="tab-btn @(_activeTab == "roster" ? "active" : "")" @onclick="@(() => _activeTab = "roster")">
                    🧙 Guild (@Engine.State.Wizards.Sum(w => w.Count))
                </button>
                <button class="tab-btn @(_activeTab == "research" ? "active" : "")" @onclick="@(() => _activeTab = "research")">
                    🏛️ Academy
                </button>
                <button class="tab-btn @(_activeTab == "astral" ? "active" : "")" @onclick="@(() => _activeTab = "astral")">
                    🌌 Astral
                </button>
            </nav>

            <div class="tab-content">
                @if (_activeTab == "gear")
                {
                    <EquipmentInventory />
                }
                else if (_activeTab == "roster")
                {
                    <WizardRoster />
                }
                else if (_activeTab == "research")
                {
                    <UpgradeShop />
                }
                else if (_activeTab == "astral")
                {
                    <AstralAscension OnAscended="HandleAscended" />
                }
            </div>
        </aside>
    </div>

    <!-- Small Floating Notification Toast Bubble -->
    @if (!string.IsNullOrEmpty(_currentToast))
    {
        <div class="toast-bubble-container">
            <div class="toast-bubble">
                <span class="bubble-icon">✨</span>
                <span class="bubble-text">@_currentToast</span>
            </div>
        </div>
    }

    <!-- Modals -->
    @if (_showSettingsModal)
    {
        <SettingsModal OnClose="() => _showSettingsModal = false" />
    }

    <OfflineGainsModal />
</div>

@code {
    private string _activeTab = "roster";
    private bool _showSettingsModal = false;
    private string? _currentToast = null;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        Engine.OnStateChanged += HandleStateChanged;
        Engine.OnNotification += ShowToast;

        await Engine.InitializeAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ShowToast(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        _currentToast = message;
        InvokeAsync(StateHasChanged);

        _ = Task.Delay(2500, _toastCts.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _currentToast = null;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task ManualSave()
    {
        await Engine.SaveAsync();
        ShowToast("Game saved successfully!");
    }

    private void HandleAscended()
    {
        _activeTab = "roster";
    }

    public void Dispose()
    {
        Engine.OnStateChanged -= HandleStateChanged;
        Engine.OnNotification -= ShowToast;
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
