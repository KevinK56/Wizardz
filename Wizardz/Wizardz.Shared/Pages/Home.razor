@page "/"
@implements IDisposable
@inject GameEngine Engine

<PageTitle>Wizardz - Celestial Roguelite</PageTitle>

<div class="game-viewport">
    <!-- Top Retro Pixel Status & Mode Navigation Bar -->
    <header class="game-header">
        <div class="brand-section">
            <span class="brand-icon">🧙‍♂️</span>
            <h1 class="brand-title">WIZARDZ</h1>
        </div>

        <!-- Center Game Mode Tabs (Full-Screen Flow) -->
        <nav class="game-modes-nav">
            <button class="mode-nav-btn @(_currentMode == GameMode.Dungeon ? "active" : "")"
                    @onclick="() => SwitchMode(GameMode.Dungeon)">
                ⚔️ DUNGEON
            </button>
            <button class="mode-nav-btn @(_currentMode == GameMode.Constellation ? "active" : "")"
                    @onclick="() => SwitchMode(GameMode.Constellation)">
                🌌 CONSTELLATION
            </button>
            <button class="mode-nav-btn @(_currentMode == GameMode.Armory ? "active" : "")"
                    @onclick="() => SwitchMode(GameMode.Armory)">
                🎒 ARMORY (@Engine.State.Inventory.Count)
            </button>
        </nav>

        <!-- Right Resources & Settings -->
        <div class="header-right-group">
            <div class="resource-pill mana" title="Available Mana">
                <span class="res-icon">🔮</span>
                <span class="res-value">@GameEngine.FormatNumber(Engine.State.Mana)</span>
            </div>

            @if (Engine.State.ArcaneEssence > 0)
            {
                <div class="resource-pill essence" title="Arcane Essence">
                    <span class="res-icon">💠</span>
                    <span class="res-value">@GameEngine.FormatNumber(Engine.State.ArcaneEssence)</span>
                </div>
            }

            <button class="btn-icon-action" @onclick="() => _showSettingsModal = true" title="Settings">
                ⚙️
            </button>
        </div>
    </header>

    <!-- Main Full-Screen Game Content Window -->
    <main class="game-screen-workspace">
        @if (_currentMode == GameMode.Dungeon)
        {
            <div class="dungeon-run-container">
                <ScrollingDungeonCanvas OnNavigateToConstellation="() => SwitchMode(GameMode.Constellation)" />
            </div>
        }
        else if (_currentMode == GameMode.Constellation)
        {
            <div class="constellation-screen-container">
                <ConstellationSkillTree />
                <div class="quick-descend-bar">
                    <button class="btn-launch-run" @onclick="() => SwitchMode(GameMode.Dungeon)">
                        ⚔️ DESCEND INTO DUNGEON (FLOOR @Engine.State.CurrentDungeonFloor)
                    </button>
                </div>
            </div>
        }
        else if (_currentMode == GameMode.Armory)
        {
            <div class="armory-screen-container">
                <EquipmentInventory />
                <div class="quick-descend-bar">
                    <button class="btn-launch-run" @onclick="() => SwitchMode(GameMode.Dungeon)">
                        ⚔️ DESCEND INTO DUNGEON (FLOOR @Engine.State.CurrentDungeonFloor)
                    </button>
                </div>
            </div>
        }
    </main>

    <!-- Small Floating Notification Toast Bubble -->
    @if (!string.IsNullOrEmpty(_currentToast))
    {
        <div class="toast-bubble-container">
            <div class="toast-bubble">
                <span class="bubble-icon">✨</span>
                <span class="bubble-text">@_currentToast</span>
            </div>
        </div>
    }

    <!-- Settings Modal -->
    @if (_showSettingsModal)
    {
        <SettingsModal OnClose="() => _showSettingsModal = false" />
    }
</div>

@code {
    public enum GameMode
    {
        Dungeon,
        Constellation,
        Armory
    }

    private GameMode _currentMode = GameMode.Dungeon;
    private bool _showSettingsModal = false;
    private string? _currentToast = null;
    private CancellationTokenSource? _toastCts;

    protected override async Task OnInitializedAsync()
    {
        Engine.OnStateChanged += HandleStateChanged;
        Engine.OnNotification += ShowToast;

        await Engine.InitializeAsync();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SwitchMode(GameMode mode)
    {
        _currentMode = mode;
        InvokeAsync(StateHasChanged);
    }

    private void ShowToast(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        _currentToast = message;
        InvokeAsync(StateHasChanged);

        _ = Task.Delay(2500, _toastCts.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _currentToast = null;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    public void Dispose()
    {
        Engine.OnStateChanged -= HandleStateChanged;
        Engine.OnNotification -= ShowToast;
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
